# ==========================================
# APIRESTNodejs - Variables de Entorno
# ==========================================
# Copia este archivo a .env y rellena los valores reales.

# Configuración del Servidor
puerto = 3000
API_KEY = cambia-esta-clave-por-una-segura

# Configuración Local-First (SQLite)
SQLITE_PATH = ./data/cache.sqlite
SYNC_INTERVAL_MS = 120000

# Base de Datos Remota (SQL Server)
DB_USER = tu_usuario_sql
DB_PASSWORD = tu_contraseña_sql
DB_SERVER = tu_servidor.mssql.somee.com
DB_NAME = nombre_de_tu_base_de_datos
DB_TRUST_SERVER_CERT = true